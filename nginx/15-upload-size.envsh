#!/bin/sh
# MAX_UPLOAD_SIZE is shared with the Spring server, which uses "5GB"/"512MB";
# nginx wants "5g"/"512m". Translate before the template is rendered.
size=$(printf '%s' "${MAX_UPLOAD_SIZE:-5GB}" | tr '[:upper:]' '[:lower:]' | tr -d ' ')
case "$size" in
  *[0-9]kb|*[0-9]mb|*[0-9]gb) size="${size%b}" ;;
  *[0-9]b) size="${size%b}" ;;
esac
case "$size" in
  *[0-9]|*[0-9]k|*[0-9]m|*[0-9]g) ;;
  *) echo "15-upload-size: unsupported MAX_UPLOAD_SIZE '$MAX_UPLOAD_SIZE', using 5g" >&2; size=5g ;;
esac
export NGINX_MAX_BODY_SIZE="$size"
